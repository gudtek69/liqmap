# Copy to .env and edit. All values are optional; defaults shown.
# No API keys are needed: every data source is a free public endpoint (Hyperliquid info API, OKX rubik stats).

# Coins to map/track (Hyperliquid tickers that also have an OKX <COIN>-USDT-SWAP contract)
LIQMAP_COINS=BTC,ETH,SOL

# Local web server for the map page (fetcher.py)
LIQMAP_HOST=127.0.0.1
LIQMAP_PORT=8787
LIQMAP_REFRESH=60

# Folder the tracker copies stats.json / params.json into (defaults to ./web next to ./tracker)
# LIQMAP_WEB=./web
# Tracker folder the web server falls back to for stats.json / params.json
# LIQMAP_TRACKER=./tracker
# Where the tracker/optimizer keep tracker.db, backtest.json, stats.json and the history cache
# LIQMAP_DATA=./tracker/data

# Optimizer knobs
# HIST_H=720   # hours of history to backtest
# STEP=3       # hours between replayed calls
# N_CAND=24    # random parameter candidates per run
# SEED=7
